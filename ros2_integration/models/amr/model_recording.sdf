<?xml version="1.0" ?>
<!--
  model_recording.sdf — AMR model optimized for SIH video recording.

  Differences from model.sdf (normal):
    - Shadow casting: NONE (shadows=false on all visuals)
    - Specular: removed from all materials
    - LiDAR: 3 Hz, 36 rays (vs 5 Hz 72 rays)  — still detects SCENARIO_C blockage
    - IMU:    25 Hz (vs 100 Hz)               — sufficient for heading correction
    - Odom:   15 Hz (vs 30 Hz)                — sufficient for 10Hz control loop
    - All visual geometry: IDENTICAL (robot still looks the same)
    - All collision geometry: UNCHANGED (footprint/safety unchanged)

  Physical spec: IDENTICAL to model.sdf (derived from simulator/robot.py)
    Length: 0.8m  Width: 0.6m  Height: 0.35m
    Bounding radius: 0.45m  Max velocity: 1.5 m/s
-->
<sdf version="1.10">
  <model name="amr">

    <!-- ── Chassis ───────────────────────────────────────────────────────── -->
    <link name="base_link">
      <inertial>
        <pose>0 0 -0.05 0 0 0</pose>
        <mass>80.0</mass>
        <inertia>
          <ixx>2.9</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.0</iyy><iyz>0</iyz>
          <izz>6.4</izz>
        </inertia>
      </inertial>

      <!-- Chassis collision (low friction prevents ground dragging if pitched) -->
      <collision name="chassis_collision">
        <geometry><box><size>0.8 0.6 0.35</size></box></geometry>
        <surface>
          <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
        </surface>
      </collision>

      <!-- Chassis visual — no specular -->
      <visual name="chassis_visual">
        <geometry><box><size>0.8 0.6 0.35</size></box></geometry>
        <material>
          <ambient>0.1 0.5 0.9 1</ambient>
          <diffuse>0.1 0.5 0.9 1</diffuse>
          <specular>0 0 0 0</specular>
        </material>
      </visual>

      <!-- Protective bumper -->
      <visual name="bumper_visual">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><box><size>0.84 0.64 0.12</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0 0 0 0</specular>
        </material>
      </visual>

      <!-- Forward heading arrow -->
      <visual name="heading_arrow_stem">
        <pose>0.26 0 0.182 0 0 0</pose>
        <geometry><box><size>0.16 0.08 0.015</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
      <visual name="heading_arrow_tip">
        <pose>0.34 0 0.182 0 0 0</pose>
        <geometry><box><size>0.08 0.18 0.015</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>

      <!-- LiDAR housing -->
      <visual name="lidar_housing_visual">
        <pose>0.0 0 0.22 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.09</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0 0 0 0</specular>
        </material>
      </visual>
      <visual name="lidar_ring_visual">
        <pose>0.0 0 0.24 0 0 0</pose>
        <geometry><cylinder><radius>0.082</radius><length>0.025</length></cylinder></geometry>
        <material>
          <ambient>0.0 0.9 1.0 1</ambient>
          <diffuse>0.0 0.9 1.0 1</diffuse>
          <specular>0 0 0 0</specular>
        </material>
      </visual>

      <!-- ID mast -->
      <visual name="id_mast_visual">
        <pose>0 0 0.31 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.14</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.25 0.25 0.30 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
      <visual name="id_plaque_border">
        <pose>0 0 0.39 0 0 0</pose>
        <geometry><box><size>0.045 0.36 0.15</size></box></geometry>
        <material><ambient>0.9 0.9 0.95 1</ambient><diffuse>0.95 0.95 1.0 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
      <visual name="id_plaque_backing">
        <pose>0 0 0.39 0 0 0</pose>
        <geometry><box><size>0.04 0.34 0.14</size></box></geometry>
        <material><ambient>0.08 0.10 0.15 1</ambient><diffuse>0.10 0.12 0.18 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>

      <!-- Cargo deck -->
      <visual name="cargo_deck_base">
        <pose>-0.18 0 0.18 0 0 0</pose>
        <geometry><box><size>0.32 0.36 0.015</size></box></geometry>
        <material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.22 0.25 0.30 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
      <visual name="cargo_deck_hazard_stripe">
        <pose>-0.18 0 0.185 0 0 0</pose>
        <geometry><box><size>0.30 0.34 0.005</size></box></geometry>
        <material><ambient>0.95 0.75 0.05 1</ambient><diffuse>0.98 0.80 0.08 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
      <!-- ROBOT_PAYLOAD_VISUAL -->

      <!-- 360-Degree Perimeter LED Halo Status Ring -->
      <visual name="led_halo_ring">
        <pose>0 0 0.178 0 0 0</pose>
        <geometry><box><size>0.82 0.62 0.018</size></box></geometry>
        <material>
          <ambient>0.1 0.5 0.9 1</ambient>
          <diffuse>0.1 0.5 0.9 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <!-- Twin High-Lumen Forward LED Headlights -->
      <visual name="headlight_left">
        <pose>0.42 0.18 -0.06 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.015</length></cylinder></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>
      <visual name="headlight_right">
        <pose>0.42 -0.18 -0.06 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.015</length></cylinder></geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>

      <!-- Dual Ball Caster Bearings (Front & Rear, ground-aligned at z=-0.275) -->
      <!-- Front caster: center at z=-0.225, radius 0.05 => bottom at -0.275 (exact ground plane) -->
      <collision name="front_caster_collision">
        <pose>0.32 0 -0.225 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="front_caster_visual">
        <pose>0.32 0 -0.225 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>

      <!-- Rear caster: center at z=-0.225, radius 0.05 => bottom at -0.275 (exact ground plane) -->
      <collision name="rear_caster_collision">
        <pose>-0.32 0 -0.225 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="rear_caster_visual">
        <pose>-0.32 0 -0.225 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>

      <!-- 2D LiDAR — high performance CPU ray sensor (eliminates WSLg GPU readback stall) -->
      <sensor name="lidar" type="lidar">
        <pose>0.0 0 0.2 0 0 0</pose>
        <update_rate>2</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>36</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>

      <!-- IMU — recording profile: 25 Hz -->
      <sensor name="imu" type="imu">
        <pose>0 0 0.1 0 0 0</pose>
        <update_rate>25</update_rate>
        <always_on>true</always_on>
        <topic>imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ── Left wheel ──────────────────────────────────────────────────── -->
    <link name="left_wheel">
      <pose>0 0.26 -0.125 -1.5707963 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0051</iyy><iyz>0</iyz>
          <izz>0.009</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <visual name="tire_visual">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
      <visual name="hubcap_visual">
        <geometry><cylinder><radius>0.08</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.75 0.75 0.8 1</ambient><diffuse>0.75 0.75 0.8 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
    </link>

    <!-- ── Right wheel ─────────────────────────────────────────────────── -->
    <link name="right_wheel">
      <pose>0 -0.26 -0.125 -1.5707963 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0051</iyy><iyz>0</iyz>
          <izz>0.009</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <visual name="tire_visual">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
      <visual name="hubcap_visual">
        <geometry><cylinder><radius>0.08</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.75 0.75 0.8 1</ambient><diffuse>0.75 0.75 0.8 1</diffuse><specular>0 0 0 0</specular></material>
      </visual>
    </link>

    <!-- ── Joints ────────────────────────────────────────────────────── -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- ── Differential drive — recording: 15 Hz odom ───────────────── -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.52</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_accel>3.0</max_linear_accel>
      <max_linear_decel>4.0</max_linear_decel>
      <max_angular_accel>6.28</max_angular_accel>
      <max_linear_velocity>1.5</max_linear_velocity>
      <max_angular_velocity>3.14</max_angular_velocity>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <topic>cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <tf_topic>tf</tf_topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

  </model>
</sdf>
