<?xml version="1.0" ?>
<!--
  warehouse_s4.sdf — Gazebo Harmonic world for S4/S8 scenarios.
  25x20 grid with central dividing wall and two choke passages at y=5 and y=14.
  Mirrors _make_choke_grid() in fleet_launcher.py.
  Scale: 1 grid cell = 1.0 m, FLIP_Y=True (grid row 0 = world Y max = 19)
-->
<sdf version="1.10">
  <world name="warehouse_s4">

    <physics name="default" type="ode">
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>
    <atmosphere type="adiabatic"/>

    <!-- ── GUI ─────────────────────────────────────────────────────────── -->
    <gui fullscreen="0">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.7 0.7 0.7</background_color>
        <camera_pose>12.0 1.8 11.0 0 0.96 1.5708</camera_pose>
      </plugin>

      <!-- Plugins that add functionality to the scene -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>

    <scene>
      <ambient>0.5 0.5 0.55 1</ambient>
      <background>0.12 0.15 0.18 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>25 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>25 20</size></plane></geometry>
          <material>
            <ambient>0.22 0.25 0.28 1</ambient>
            <diffuse>0.22 0.25 0.28 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
        <pose>12.0 9.5 0 0 0 0</pose>
      </link>
    </model>

    <!-- Perimeter walls (high-contrast industrial silver) -->
    <model name="wall_west">
      <static>true</static><pose>0.1 9.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.0 2.5</size></box></geometry><material><ambient>0.65 0.68 0.72 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>23.9 9.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.0 2.5</size></box></geometry><material><ambient>0.65 0.68 0.72 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>12.0 19.9 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25.0 0.2 2.5</size></box></geometry><material><ambient>0.65 0.68 0.72 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>12.0 0.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25.0 0.2 2.5</size></box></geometry><material><ambient>0.65 0.68 0.72 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      </link>
    </model>

    <!--
      Central dividing wall at grid x=12 (world x=12.0).
      Choke passages at grid y=5 (world y=14.0) and grid y=14 (world y=5.0).
      Wall segments cover rows 1-4, 6-13, 15-18 (skipping choke at 5 and 14).
      High-visibility safety hazard amber makes bottlenecks instantly obvious to judges.
    -->

    <!-- Segment 1: grid rows 1-4 → world y = 15..18 → center y=16.5, height=4 -->
    <model name="divider_north">
      <static>true</static>
      <pose>12.0 16.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
          <material><ambient>0.92 0.48 0.08 1</ambient><diffuse>0.92 0.48 0.08 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Choke passage at grid y=5 → world y=14.0: GAP HERE (no wall) -->

    <!-- Segment 2: grid rows 6-13 → world y = 6..13 → center y=9.5, height=8 -->
    <model name="divider_middle">
      <static>true</static>
      <pose>12.0 9.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.0 2.5</size></box></geometry>
          <material><ambient>0.92 0.48 0.08 1</ambient><diffuse>0.92 0.48 0.08 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Choke passage at grid y=14 → world y=5.0: GAP HERE (no wall) -->

    <!-- Segment 3: grid rows 15-18 → world y = 1..4 → center y=2.5, height=4 -->
    <model name="divider_south">
      <static>true</static>
      <pose>12.0 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
          <material><ambient>0.92 0.48 0.08 1</ambient><diffuse>0.92 0.48 0.08 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>


    <model name="floor_grid_telemetry">
