<?xml version="1.0" ?>
<!--
  warehouse_s8.sdf — Gazebo Harmonic world for S8 (Failure + Congestion) scenario.

  25×20 grid with central dividing wall and two choke passages (same as S4),
  PLUS: robot failure is injected at runtime via the ROS/coordination layer.

  S8 = S4 geometry + S5 failure injection
  - Central divider at grid x=12 with choke passages at grid y=5 and y=14
  - Robot failure injected at runtime (not via world geometry)

  Scale: 1 grid cell = 1.0 m
  Grid convention: col→X, row→-Y (FLIP_Y=True, grid row 0 = world Y max = 19)

  Compatible with Gazebo Harmonic (gz-sim 8.x).
-->
<sdf version="1.10">
  <world name="warehouse_s8">

    <physics name="default" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>25 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>25 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <pose>12.0 9.5 0 0 0 0</pose>
      </link>
    </model>

    <!-- Perimeter walls (same as S4) -->
    <model name="wall_west">
      <static>true</static><pose>0.1 9.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.0 2.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>23.9 9.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.0 2.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>12.0 19.9 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25.0 0.2 2.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>12.0 0.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>25.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>25.0 0.2 2.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!--
      Central dividing wall (same as S4):
      At grid x=12 (world x=12.0) with choke passages at grid y=5 (world y=14.0)
      and grid y=14 (world y=5.0).
    -->

    <!-- Segment 1: grid rows 1-4 → world y = 15..18 → center y=16.5 -->
    <model name="divider_north">
      <static>true</static>
      <pose>12.0 16.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Choke at grid y=5 → world y=14.0: GAP (no wall) -->

    <!-- Segment 2: grid rows 6-13 → world y = 6..13 → center y=9.5 -->
    <model name="divider_middle">
      <static>true</static>
      <pose>12.0 9.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.0 2.5</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Choke at grid y=14 → world y=5.0: GAP (no wall) -->

    <!-- Segment 3: grid rows 15-18 → world y = 1..4 → center y=2.5 -->
    <model name="divider_south">
      <static>true</static>
      <pose>12.0 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      S8 NOTE: Robot failure is injected at runtime (same as S5).
      The divider (orange in S4, red here for distinction) creates the
      congested choke geometry that combined with failure tests the
      full haven/retreat + failure-recovery logic.
    -->

  </world>
</sdf>
