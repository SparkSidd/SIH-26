#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/WarehouseAMR.proto"
EXTERNPROTO "../protos/WarehouseShelf.proto"

WorldInfo {
  info [
    "SIH26123 - Webots Multi-AMR Warehouse Simulation (Target 6-AMR Fleet)"
    "Decentralized AMR Fleet Coordination for Smart Warehouses"
  ]
  title "SIH26123 Target 6-AMR Fleet Warehouse"
  basicTimeStep 32
  FPS 30
  optimalThreadCount 4
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.82 0.38 -0.42 1.88
  position 12.0 -2.0 16.0
  fieldOfView 0.85
  near 0.1
}

Background {
  skyColor [
    0.18 0.20 0.24
  ]
}

DirectionalLight {
  direction -0.5 0.5 -1.0
  intensity 2.0
  castShadows FALSE
}

# ── Floor ──────────────────────────────────────────────────────────────────────
Solid {
  translation 12.0 9.5 -0.05
  name "solid"
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.40 0.42 0.45 }
      }
      geometry Box { size 25.0 20.0 0.1 }
    }
    # Central E-W aisle line
    Pose {
      translation 0 0 0.051
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.95 0.75 0.05 } }
          geometry Box { size 24.0 0.12 0.002 }
        }
      ]
    }
    # N-S cross lines
    Pose {
      translation -7.0 0 0.051
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.95 0.75 0.05 } }
          geometry Box { size 0.10 18.0 0.002 }
        }
      ]
    }
    Pose {
      translation 0 0 0.051
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.95 0.75 0.05 } }
          geometry Box { size 0.10 18.0 0.002 }
        }
      ]
    }
    Pose {
      translation 7.0 0 0.051
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.95 0.75 0.05 } }
          geometry Box { size 0.10 18.0 0.002 }
        }
      ]
    }
    # Charging bays (coloured pads)
    Pose { translation -10.0 -7.5 0.052 children [ Shape { appearance Appearance { material Material { diffuseColor 0.15 0.38 0.92 } } geometry Box { size 1.2 1.2 0.003 } } ] }
    Pose { translation -6.0 -7.5 0.052 children [ Shape { appearance Appearance { material Material { diffuseColor 0.05 0.75 0.95 } } geometry Box { size 1.2 1.2 0.003 } } ] }
    Pose { translation -2.0 -7.5 0.052 children [ Shape { appearance Appearance { material Material { diffuseColor 0.15 0.85 0.45 } } geometry Box { size 1.2 1.2 0.003 } } ] }
    Pose { translation  2.0 -7.5 0.052 children [ Shape { appearance Appearance { material Material { diffuseColor 0.95 0.65 0.05 } } geometry Box { size 1.2 1.2 0.003 } } ] }
    Pose { translation  6.0 -7.5 0.052 children [ Shape { appearance Appearance { material Material { diffuseColor 0.92 0.25 0.25 } } geometry Box { size 1.2 1.2 0.003 } } ] }
    Pose { translation 10.0 -7.5 0.052 children [ Shape { appearance Appearance { material Material { diffuseColor 0.68 0.25 0.95 } } geometry Box { size 1.2 1.2 0.003 } } ] }
  ]
  boundingObject Box { size 25.0 20.0 0.1 }
}

